# Branding (optional – leer lassen fuer neutrale Defaults)
BRAND_PRACTICE_NAME="Dr. med. Muster · Musterpraxis"
BRAND_FOOTER_HTML='Dr. med. Muster · Musterpraxis · <a href="https://example.com" target="_blank" rel="noopener">example.com</a>'
BRAND_SHOW_CREDITS=true
