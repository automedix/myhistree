# Server
PORT=3456
URL_BASE=https://myhistree.de

# Secrets (WICHTIG: beim ersten Setup aendern!)
JWT_SECRET=change-me-strong-secret-32-chars-plus
PASSWORD_PEPPER=change-me-pepper-string
DEFAULT_ADMIN_PASSWORD=admin1-please-change-me

# SMTP / Mail-Versand
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mail@example.com
SMTP_PASS=secret
EMAIL_FROM_NAME="Myhistree Anamnese"
